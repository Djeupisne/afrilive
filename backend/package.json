{
  "name": "afrilive-backend",
  "version": "1.0.0",
  "description": "AfriLive Market - NestJS backend (super-app video + live commerce + marketplace)",
  "author": "AfriLive",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.637.0",
    "@aws-sdk/s3-request-presigner": "3.637.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/axios": "3.0.3",
    "@nestjs/bullmq": "10.1.1",
    "@nestjs/common": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.4",
    "@nestjs/event-emitter": "2.0.4",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/platform-socket.io": "10.4.4",
    "@nestjs/schedule": "4.1.1",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "5.2.0",
    "@nestjs/websockets": "10.4.4",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.41.1",
    "axios": "1.7.7",
    "bcryptjs": "2.4.3",
    "bullmq": "5.12.13",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "compression": "1.7.4",
    "firebase-admin": "12.6.0",
    "fluent-ffmpeg": "2.1.3",
    "helmet": "7.2.0",
    "ioredis": "5.4.1",
    "livekit-server-sdk": "2.7.3",
    "meilisearch": "0.42.0",
    "nestjs-pino": "4.1.0",
    "nodemailer": "^6.9.15",
    "otplib": "12.0.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "0.15.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.1.4",
    "@nestjs/testing": "10.4.4",
    "@prisma/client": "5.22.0",
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/node": "20.16.10",
    "@types/nodemailer": "6.4.15",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "0.13.4",
    "@types/socket.io": "3.0.2",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "pino-pretty": "11.2.2",
    "prettier": "3.3.3",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@prisma/client$": "<rootDir>/../tests/prisma-client-stub.js"
    }
  }
}
